# ─── Multi-LLM Consensus Providers ───
LLM_PROVIDER=groq
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.1-8b-instant

GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ─── Hugging Face Open Model Settings ───
HF_TOKEN=your_huggingface_token_here
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ─── Data Lake & Vector DB ───
AWS_S3_BUCKET=blinkit-discovery-engine-raw
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=blinkit-discovery-vectors

# ─── Reddit API Credentials ───
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=blinkit-discovery-engine/1.0

# ─── Data Paths (Defaults) ───
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
INSIGHTS_DIR=data/insights
